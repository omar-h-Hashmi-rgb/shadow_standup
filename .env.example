# Copy to .env.local and fill in. NEVER commit .env.local (it is git-ignored).
# Only the NEXT_PUBLIC_* values are exposed to the browser; everything else is server-only.

# ---- Supabase ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row Level Security — never expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ---- AI providers (server-only) -----------------------------------------------
GROQ_API_KEY=
GEMINI_API_KEY=
GEMINI_API_KEY_2=

# ---- Secret encryption at rest (strongly recommended) -------------------------
# Encrypts stored webhook URLs / API tokens (AES-256-GCM). Generate with:
#   openssl rand -base64 32
# Keep it stable: changing it makes previously stored secrets unreadable.
ENCRYPTION_KEY=

# ---- Microsoft Teams notifications (optional) --------------------------------
# A Teams "Workflows" (Power Automate) webhook URL. Leave empty to disable Teams.
# This is a secret: it is only read on the server and never sent to the browser.
TEAMS_WEBHOOK_URL=
# Optional extra allowed hosts for the Teams URL (comma-separated; ".example.com" = suffix match).
TEAMS_WEBHOOK_ALLOWED_HOSTS=

# ---- Other optional integration defaults (used when a user has not saved their own) ----
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
JIRA_DOMAIN=
JIRA_EMAIL=
JIRA_TOKEN=
JIRA_PROJECT_KEY=
# Extra allowed Jira hosts beyond *.atlassian.net (comma-separated).
JIRA_ALLOWED_HOSTS=
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_LIST_ID=

# ---- Security -----------------------------------------------------------------
# Extra origins allowed to call /api/* cross-origin (comma-separated). Empty = same-origin only.
ALLOWED_ORIGINS=

# ---- Development only ---------------------------------------------------------
# Used only when NODE_ENV=development and the request carries no token of its own.
GITHUB_PERSONAL_ACCESS_TOKEN=
